;; **
;; ** Widgets config for EWW
;; ** Created by : @adi1090x
;; ** Converted by : @tripleo1
;; **

;; ** Variables ***********************************************************************

;; Profile vars
(defvar IMAGE "images/profile.jpg")
(defvar NAME "Swapnil")
(defpoll UNAME :interval "5m" `whoami`)
(defpoll FORTUNE :interval "1h" `fortune -s`)

;; System vars
(defpoll HOST :interval "5s" `hostname`)
(defpoll CPU_USAGE :interval "1s" :initial "0" `~/.config/eww/scripts/sys_info --cpu`)
(defpoll MEM_USAGE :interval "1s" :initial "0" `~/.config/eww/scripts/sys_info --mem`)
(defpoll BLIGHT :interval "1s" :initial "0" `~/.config/eww/scripts/sys_info --blight`)
(defpoll BATTERY :interval "5s" :initial "0" `~/.config/eww/scripts/sys_info --bat`)

;; Time vars
(defpoll HOUR :interval "5s" `date +\"%I\"`)
(defpoll MIN :interval "5s" `date +\"%M\"`)
(defpoll MER :interval "5s" `date +\"%p\"`)
(defpoll DAY :interval "5s" `date +\"%A\"`)

;; Machine vars
(defpoll OS :interval "5m" `sed -n 's/^PRETTY_NAME=//p' /etc/os-release | tr -d '\"'`)
(defpoll KERNEL :interval "5m" `uname -r`)

;; Music vars
(defpoll SONG :interval "1s" `~/.config/eww/scripts/music_info --song`)
(defpoll ARTIST :interval "1s" `~/.config/eww/scripts/music_info --artist`)
(defpoll STATUS :interval "1s" `~/.config/eww/scripts/music_info --status`)
(defpoll CURRENT :interval "1s" :initial "0" `~/.config/eww/scripts/music_info --time`)
(defpoll COVER :interval "1s" `~/.config/eww/scripts/music_info --cover`)
(defpoll CTIME :interval "1s" `~/.config/eww/scripts/music_info --ctime`)
(defpoll TTIME :interval "1s" `~/.config/eww/scripts/music_info --ttime`)

;; Weather vars
(defpoll ICON :interval "15m" `~/.config/eww/scripts/weather_info --icon`)
(defpoll STAT :interval "15m" `~/.config/eww/scripts/weather_info --stat`)
(defpoll TEMP :interval "15m" `~/.config/eww/scripts/weather_info --temp`)
(defpoll HEX :interval "15m" `~/.config/eww/scripts/weather_info --hex`)
(defpoll QUOTE :interval "15m" `~/.config/eww/scripts/weather_info --quote`)
(defpoll QUOTE2 :interval "15m" `~/.config/eww/scripts/weather_info --quote2`)

;; Files vars
(defpoll FREE :interval "5s" `df -h / | awk '{print $4}' | tail -n 1 | sed 's/G/GB/'`)


;; ** Widgets *************************************************************************


;; background
(defwidget bg [] 
	(box :class "bg")
)

;; profile
(defwidget user [] 
	(box :class "genwin profile-card" :orientation "v" :spacing 12 :space-evenly "false" :vexpand "false" :hexpand "true"
		(box :style "background-image: url('${IMAGE}');" :class "face" :halign "center")
		(box :orientation "v" :spacing 3 :hexpand "true"
			(label :class "fullname" :halign "center" :text NAME)
			(label :class "username" :halign "center" :text UNAME))
		(box :class "profile-rule" :halign "center")
		(label :class "fortune" :halign "center" :justify "center" :wrap "true" :text FORTUNE)))

;; system
(defwidget system [] 
	(box :class "genwin system-card" :vexpand "true" :hexpand "true" 
		(box :orientation "v" :spacing 14 :halign "fill" :valign "center" :space-evenly "false" :vexpand "true" :hexpand "true" 
			(box :class "cpu_bar" :orientation "h" :spacing 20 :space-evenly "false" :vexpand "false" :hexpand "false" 
				(label :class "iconcpu" :text "")
				(scale :min 0 :max 100 :value CPU_USAGE :active "false")
				(label :class "metric_value" :text CPU_USAGE))
			(box :class "mem_bar" :orientation "h" :spacing 20 :space-evenly "false" :vexpand "false" :hexpand "false" 
				(label :class "iconmem" :text "󰍛")
				(scale :min 0 :max 100 :value MEM_USAGE :active "false")
				(label :class "metric_value" :text MEM_USAGE))
			(box :class "bright_bar" :orientation "h" :spacing 20 :space-evenly "false" :vexpand "false" :hexpand "false" 
				(label :class "iconbright" :text "󰃠")
				(scale :min 0 :max 100 :value BLIGHT :active "false")
				(label :class "metric_value" :text BLIGHT))
			(box :class "bat_bar" :orientation "h" :spacing 20 :space-evenly "false" :vexpand "false" :hexpand "false" 
				(label :class "iconbat" :text "󰁹")
				(scale :min 0 :max 100 :value BATTERY :active "false")
				(label :class "metric_value" :text BATTERY)))))

;; clock
(defwidget clock []
	(box :class "genwin clock" :orientation "v" :spacing 2 :halign "fill" :valign "fill" :space-evenly "true" :vexpand "true" :hexpand "true"
		(box :class "clock_time" :orientation "h" :spacing 4 :halign "center" :hexpand "true"
			(label :class "time_hour" :text HOUR)
			(label :class "time_separator" :text ":")
			(label :class "time_min" :text MIN))
		(box :class "clock_meta" :orientation "h" :spacing 10 :halign "center" :hexpand "true"
			(label :class "time_day" :text DAY)
			(label :class "time_mer" :text MER))))

;; machine summary
(defwidget machine []
	(box :class "genwin machine" :orientation "v" :spacing 4 :halign "fill" :valign "fill" :space-evenly "true" :vexpand "true" :hexpand "true"
		(box :class "machine_row" :orientation "h" :spacing 14 :halign "start" :hexpand "true"
			(label :class "machine_icon" :text "󰣇")
			(label :class "machine_value" :text HOST))
		(box :class "machine_row" :orientation "h" :spacing 14 :halign "start" :hexpand "true"
			(label :class "machine_icon" :text "󰀻")
			(label :class "machine_value" :wrap "true" :text OS))
		(box :class "machine_row" :orientation "h" :spacing 14 :halign "start" :hexpand "true"
			(label :class "machine_icon" :text "󰌽")
			(label :class "machine_value" :text KERNEL))))

;; Music
(defwidget music [] 
	(box :class "genwin" :orientation "h" :space-evenly "false" :vexpand "false" :hexpand "false" 
		(box :class "album_art" :vexpand "false" :hexpand "false" :style "background-image: url('${COVER}');")
		(box :orientation "v" :spacing 24 :valign "center" :space-evenly "false" :vexpand "true" :hexpand "true" 
			(label :halign "center" :class "song" :wrap "true" :text SONG)
			(label :halign "center" :class "artist" :wrap "true" :text ARTIST)
			(box :orientation "h" :spacing 20 :halign "center" :space-evenly "true" :vexpand "false" :hexpand "false" 
				(button :class "btn_prev" :onclick "~/.config/eww/scripts/music_info --prev" "󰒮")
				(button :class "btn_play" :onclick "~/.config/eww/scripts/music_info --toggle" STATUS)
				(button :class "btn_next" :onclick "~/.config/eww/scripts/music_info --next" "󰒭"))
			(box :class "music_bar" :halign "center" :vexpand "false" :hexpand "false" 
				(scale :min 0 :active "true" :max 100 :value CURRENT)))))

;; weather
(defwidget weather [] 
	(box :class "genwin" 
		(box :class "weather_content" :orientation "v" :spacing 18 :halign "center" :valign "center" :space-evenly "false" :vexpand "true" :hexpand "true" 
			(box :class "weather_header" :orientation "h" :vexpand "false" :hexpand "true" 
				(label :class "iconweather" :halign "start" :text ICON)
				(label :class "label_temp" :halign "end" :text TEMP))
			(box :orientation "v" :spacing 10 :halign "center" :space-evenly "false" :vexpand "false" :hexpand "true" 
				(label :class "label_stat" :wrap "true" :text STAT)
				(label :class "label_quote" :wrap "true" :text QUOTE)
				(label :class "label_quote" :wrap "true" :text QUOTE2)))))

;; power buttons
(defwidget logout [] 
	(box :class "genwin" :vexpand "false" :hexpand "false" 
		(button :class "btn_logout" :onclick "swaynag -t warning -m 'Log out of Sway?' -Z 'Log out' 'swaymsg exit'" "󰍃")))
(defwidget sleep [] 
	(box :class "genwin" :vexpand "false" :hexpand "false" 
		(button :class "btn_sleep" :onclick "sh -c 'wayland-lock || true; loginctl suspend -i'" "󰒲")))
(defwidget reboot [] 
	(box :class "genwin" :vexpand "false" :hexpand "false" 
		(button :class "btn_reboot" :onclick "swaynag -t warning -m 'Restart this computer?' -Z 'Reboot' 'loginctl reboot'" "󰜉")))
(defwidget poweroff [] 
	(box :class "genwin" :vexpand "false" :hexpand "false" 
		(button :class "btn_poweroff" :onclick "swaynag -t warning -m 'Power off this computer?' -Z 'Power off' 'loginctl poweroff'" "󰐥")))

;; folders
(defwidget folders [] 
	(box :class "genwin" :orientation "v" :space-evenly "false" :vexpand "false" :hexpand "false" 
		(box :class "hddbox" :orientation "h" :space-evenly "false" :vexpand "false" :hexpand "false" 
			(box :space-evenly "false" :vexpand "false" :hexpand "false"
				(button :class "hddicon" :onclick "$HOME/.local/bin/lfub" "󰋊"))
			(box :space-evenly "false" :vexpand "false" :hexpand "false" 
				(label :class "hdd_label" :wrap "true" :text FREE)))
		(box :orientation "h" :space-evenly "false" :vexpand "false" :hexpand "false" 
			(button :class "iconfolder1" :onclick "~/.config/eww/scripts/open_folders --docs" "󰈙")
			(button :class "label_folder1" :onclick "~/.config/eww/scripts/open_folders --docs" "Documents"))
		(box :orientation "h" :space-evenly "false" :vexpand "false" :hexpand "false" 
			(button :class "iconfolder2" :onclick "~/.config/eww/scripts/open_folders --dl" "󰉍")
			(button :class "label_folder2" :onclick "~/.config/eww/scripts/open_folders --dl" "Downloads"))
		(box :orientation "h" :space-evenly "false" :vexpand "false" :hexpand "false" 
			(button :class "iconfolder3" :onclick "~/.config/eww/scripts/open_folders --music" "󱍙")
			(button :class "label_folder3" :onclick "~/.config/eww/scripts/open_folders --music" "Music"))
		(box :orientation "h" :space-evenly "false" :vexpand "false" :hexpand "false" 
			(button :class "iconfolder4" :onclick "~/.config/eww/scripts/open_folders --pics" "󰉏")
			(button :class "label_folder4" :onclick "~/.config/eww/scripts/open_folders --pics" "Pictures"))
		(box :orientation "h" :space-evenly "false" :vexpand "false" :hexpand "false" 
			(button :class "iconfolder5" :onclick "~/.config/eww/scripts/open_folders --cfg" "󱁿")
			(button :class "label_folder5" :onclick "~/.config/eww/scripts/open_folders --cfg" "~/.config"))
		(box :orientation "h" :space-evenly "false" :vexpand "false" :hexpand "false" 
			(button :class "iconfolder6" :onclick "~/.config/eww/scripts/open_folders --local" "󰉋")
			(button :class "label_folder6" :onclick "~/.config/eww/scripts/open_folders --local" "~/.local"))))


;; ** Windows *************************************************************************


;; profile
(defwindow profile :stacking "bg" :focusable "false" :monitor 0 
	    :geometry (geometry :x 150 :y 150 :width 350 :height 440)
					(user))

;; system
(defwindow system :stacking "bg" :focusable "false" :monitor 0 
	    :geometry (geometry :x 150 :y 605 :width 350 :height 325)
					(system))

;; clock
(defwindow clock :stacking "bg" :focusable "false" :monitor 0 
	    :geometry (geometry :x 515 :y 150 :width 350 :height 155)
					(clock))

;; machine
(defwindow machine :stacking "bg" :focusable "false" :monitor 0 
	    :geometry (geometry :x 515 :y 320 :width 350 :height 155)
					(machine))

;; music
(defwindow music :stacking "bg" :focusable "false" :monitor 0 
	    :geometry (geometry :x 515 :y 490 :width 915 :height 440)
					(music))

;; weather
(defwindow weather :stacking "bg" :focusable "false" :monitor 0 
	    :geometry (geometry :x 880 :y 150 :width 550 :height 325)
					(weather))

;; logout
(defwindow logout :stacking "bg" :focusable "false" :monitor 0 
	    :geometry (geometry :x 1445 :y 150 :width 155 :height 155)
					(logout))

;; sleep
(defwindow sleep :stacking "bg" :focusable "false" :monitor 0 
	    :geometry (geometry :x 1615 :y 150 :width 155 :height 155)
					(sleep))

;; reboot
(defwindow reboot :stacking "bg" :focusable "false" :monitor 0 
	    :geometry (geometry :x 1445 :y 320 :width 155 :height 155)
					(reboot))

;; poweroff
(defwindow poweroff :stacking "bg" :focusable "false" :monitor 0 
	    :geometry (geometry :x 1615 :y 320 :width 155 :height 155)
					(poweroff))

;; folders
(defwindow folders :stacking "bg" :focusable "false" :monitor 0 
	    :geometry (geometry :x 1445 :y 490 :width 325 :height 440)
					(folders))
