#!/bin/sh
set -eu

device_name=$(hostnamectl --pretty 2>/dev/null || true)
[ -n "$device_name" ] || device_name=$(hostname 2>/dev/null || printf 'Unknown')
user_name=$(id -un)
# shellcheck disable=SC1091
. /etc/os-release
cpu=$(LC_ALL=C lscpu 2>/dev/null | sed -n 's/^Model name:[[:space:]]*//p' | head -n 1)
ram=$(LC_ALL=C free -h | awk '/^Mem:/ {print $3 " used / " $2}')
gpu=$(lspci 2>/dev/null | sed -nE '/(VGA|3D|Display)/{s/^[0-9A-Fa-f:.]+ //;p;q}')
uptime=$(uptime -p 2>/dev/null | sed 's/^up //')
shell_name=${SHELL:-Unknown}
shell_name=${shell_name##*/}
display=$(swaymsg -t get_outputs -r 2>/dev/null |
    jq -r '[.[] | select(.active) | "\(.name) \(.current_mode.width)x\(.current_mode.height)"] | join(", ")')

tooltip="Device: $device_name
User: $user_name
OS: ${PRETTY_NAME:-Unknown}
Kernel: $(uname -r)"

if command -v fortune >/dev/null 2>&1; then
    motd=$(fortune -s 2>/dev/null | tr '\n' ' ' | sed 's/[[:space:]]\+/ /g; s/^ //; s/ $//' || true)
    [ -z "$motd" ] || tooltip="$tooltip
MOTD: $motd"
fi

tooltip="$tooltip
CPU: ${cpu:-Unknown}
RAM: ${ram:-Unknown}
GPU: ${gpu:-Unknown}
Uptime: ${uptime:-Unknown}
Display: ${display:-Unknown}
Shell: $shell_name
WM: Sway"

jq -cn --arg text '' --arg tooltip "$tooltip" '{text: $text, tooltip: $tooltip, class: "about-device"}'
