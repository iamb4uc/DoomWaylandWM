#!/bin/sh
set -eu

export XDG_SESSION_TYPE=wayland
export XDG_CURRENT_DESKTOP=sway
export XDG_SESSION_DESKTOP=sway
export MOZ_ENABLE_WAYLAND=1
export QT_QPA_PLATFORM='wayland;xcb'
export SDL_VIDEODRIVER=wayland
export CLUTTER_BACKEND=wayland
export GDK_BACKEND='wayland,x11'
export GTK_THEME='Adwaita:dark'
export ELECTRON_OZONE_PLATFORM_HINT=wayland
export NIXOS_OZONE_WL=1
export XCURSOR_THEME=retrosmart-xcursor-win-ish-gruvbox
export XCURSOR_SIZE=24
export XKB_DEFAULT_LAYOUT=us
export XKB_DEFAULT_OPTIONS=caps:escape

XDG_DATA_DIRS=${XDG_DATA_DIRS:-/usr/local/share:/usr/share}
for data_dir in /var/lib/flatpak/exports/share "$HOME/.local/share/flatpak/exports/share"; do
	case ":$XDG_DATA_DIRS:" in
		*":$data_dir:"*) ;;
		*) XDG_DATA_DIRS="$data_dir:$XDG_DATA_DIRS" ;;
	esac
done
export XDG_DATA_DIRS

exec dbus-run-session "${WAYLAND_COMPOSITOR:-sway}"
